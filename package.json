{
  "name": "@chrischall/myatriumhealth-mcp",
  "version": "0.2.0",
  "description": "MCP server for MyAtriumHealth (Atrium Health's Epic MyChart patient portal) via the fetchproxy browser bridge.",
  "type": "module",
  "bin": {
    "myatriumhealth-mcp": "dist/bundle.js"
  },
  "mcpName": "io.github.chrischall/myatriumhealth-mcp",
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "server.json",
    "skills",
    "mint.yaml"
  ],
  "scripts": {
    "build": "tsc --noEmit && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --banner:js='import { createRequire as __createRequire } from \"module\"; const require = __createRequire(import.meta.url);' --outfile=dist/bundle.js",
    "dev": "node dist/bundle.js",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run typecheck && vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "mychart",
    "epic",
    "atrium-health",
    "myatriumhealth",
    "health-records"
  ],
  "author": "chrischall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/myatriumhealth-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.23.0",
    "@fetchproxy/server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "dotenv": "^17.4.2",
    "node-html-parser": "^9.0.3",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.7"
  }
}
