# myatriumhealth-mcp needs no credentials: it relays requests through your
# signed-in my.atriumhealth.org tab via the fetchproxy bridge.

# fetchproxy concentrator port. The whole fetchproxy fleet shares 37149 — the
# Transporter extension dials that one port. Override only when hosting.
# MAH_WS_PORT=37149

# Bridge-less sign-in (optional). With these set, the server logs in directly and
# the browser bridge is not used at all. Verification stays human-in-the-loop: the
# portal sends a code to the account holder and you supply it via mah_verify_code.
# Leaving them unset keeps the default bridge mode, which holds no credentials.
# MAH_USERNAME=
# MAH_PASSWORD=

# Where the portal's device-trust token is stored (0600). Defaults to
# ~/.myatriumhealth-mcp/device.json.
# MAH_DEVICE_FILE=
