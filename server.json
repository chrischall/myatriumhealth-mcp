{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.chrischall/myatriumhealth-mcp",
  "description": "MyAtriumHealth (Epic MyChart) records via your signed-in browser tab",
  "repository": {
    "url": "https://github.com/chrischall/myatriumhealth-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@chrischall/myatriumhealth-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MAH_WS_PORT",
          "description": "Override the fetchproxy WebSocket port (default 37149).",
          "isRequired": false,
          "format": "string"
        }
      ]
    }
  ]
}
